[Unit]
Description=Compacta sessões do OpenCode acima do teto (ociosas, sem trabalho em voo)
Documentation=https://github.com/marcos-toliveira/opencode-compact-if-big
# Política: generic-dev/knowledge/opencode.md §12
#
# Só age em sessão SEM ATIVIDADE há >= 2h (--ocioso 2h) e mantém as travas: turno em andamento,
# subagente ativo ou prompts na fila impedem a compactação.
#
# A janela folgada não é detalhe: em 30/09/2026 a primeira versão usava 15 min e media a ociosidade
# pelo último `assistant` (um turno longo parecia sessão abandonada) - o gatilho acabou compactando
# a PRÓPRIA conversa em uso. Desde a 0.6.0 a ociosidade é medida por atividade real (usuário ou
# assistente) e sessões já compactadas sem uso novo ficam de fora, mas a folga de 2h continua sendo
# a proteção de quem trabalha devagar, lê, ou deixa um turno longo rodando.

[Service]
Type=oneshot
ExecStart=%h/.local/bin/opencode-compact-if-big --once --above 600k --apply --ocioso 2h --log %h/.local/state/opencode-compact/compact.log
Nice=10

# ---------------------------------------------------------------------------------------------
# Endurecimento (30/09/2026). O gatilho só precisa de três coisas:
#   1. LER o banco local do OpenCode  -> $HOME em somente-leitura basta;
#   2. PEDIR a compactação por HTTP em 127.0.0.1 (porta do serviço) -> loopback liberado;
#   3. ESCREVER o próprio log e o log do CLI -> os dois únicos caminhos graváveis.
# Nada além disso é alcançável: /usr, /etc e o resto do sistema ficam somente-leitura, e o
# `$HOME` inteiro (banco, configs, chaves) fica somente-leitura - nem em tese o processo
# compacta o que não deveria, apaga arquivo ou sai gravando por aí.
# ---------------------------------------------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/opencode-compact %h/.local/share/opencode/log
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# NOTA (verificado em 30/09/2026, systemd 261 + cgroup v2): `IPAddressDeny`/`IPAddressAllow` NÃO são
# aplicados em serviço de USUÁRIO aqui - dentro de um systemd-run --user com IPAddressDeny=any uma
# conexão TCP para 1.1.1.1:53 **passou**. Por isso a diretiva foi removida: ficar com um filtro que
# não filtra é pior que não ter (dá falsa garantia). O limite real de rede é por FAMÍLIA
# (AF_UNIX/AF_INET/AF_INET6) e o código só faz uma chamada, para o servidor em 127.0.0.1.
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
