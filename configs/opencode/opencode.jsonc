{
  "$schema": "https://opencode.ai/config.json",
  // Política de cache (prefix caching) — decisão do operador, 2026-09-25:
  // - Modelo único para TODAS as sessões: DeepSeek V4.1 Flash (cache-read
  //   US$0,003/1M off-peak, ~50x mais barato que input). Medição:
  //   `opencode-cache-report` (lê o opencode.db e mostra a taxa por sessão).
  // - Regras para manter hit alto: NÃO editar AGENTS.md/prefixos no meio da
  //   sessão; NÃO ligar/desligar tools durante a sessão; prefira CONTINUAR a
  //   sessão a abrir uma nova; não trocar de modelo no meio da sessão.
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "agent": {
    "general": { "model": "opencode-go/deepseek-v4.1-flash" },
    "explore": { "model": "opencode-go/deepseek-v4.1-flash" },
    "scout": { "model": "opencode-go/deepseek-v4.1-flash" }
  },
  "command": {
    "review-profundo": {
      "template": "Faça uma revisão profunda e criteriosa do que foi indicado: $ARGUMENTS. Analise riscos, regressões, segurança e conformidade com as regras do workspace. Reporte os achados com severidade e evidência (arquivo:linha), sem editar nada.",
      "description": "Revisão profunda com DeepSeek (principal)",
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "testes-rapidos": {
      "template": "Detecte a suíte de testes do projeto atual (go test, npm test, pytest ou equivalente) e execute-a. Corrija somente as falhas apontadas, sem refatorações, repetindo até passar. Contexto: $ARGUMENTS",
      "description": "Loop rápido de testes e correções com DeepSeek",
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "lint-limpo": {
      "template": "Execute a checagem estática/lint do projeto atual (golangci-lint, eslint, ruff ou equivalente) e aplique as correções de conformidade. Contexto: $ARGUMENTS",
      "description": "Lint e conformidade com DeepSeek",
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  // Compactação — chaves VÁLIDAS do schema v2 (descoberto em 29/09/2026: `keep`/`buffer`
  // NÃO existem no schema e vinham sendo IGNORADAS; o equivalente é
  // `preserve_recent_tokens` (antes keep.tokens=24000) e `reserved` (antes buffer=16000)).
  // Demais chaves válidas: `auto`, `prune` (poda de tool outputs) e `tail_turns`.
  // Contexto do modelo = 1M e a mediana de latência satura em ~11-15 s acima de ~150k, então
  // NÃO perseguimos sessões pequenas: o custo real é `nº de requisições × pedágio (~20 s)`
  // e o pedágio cai sobretudo na faixa baixa de prefixo + cauda (p90). Ver
  // generic-dev/knowledge/opencode.md §8 e tasks/opencode-latency-test/evidence/custo-steps-pedagio.md
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 24000,
    "reserved": 16000
  },
  // POLÍTICA DE MCP (atualizada 09/10/2026) — este é o perfil PRINCIPAL (tráfego):
  // ai-memory + google-ads + hostinger-wordpress + hostinger-hosting + clickbank ligados.
  // Os 2 Hostinger somam ~102 dos 131 schemas de tool e pesam no prefixo/latência.
  // Para trabalhar SEM os MCPs pesados (hostinger-* e clickbank), use a instância `opencode-2`
  // (~/.opencode-go2): clone deste perfil com esses três DESLIGADOS e o resto idêntico.
  // O antigo `opencode-hosting` foi APOSENTADO em 09/10/2026 (virou no-op quando este arquivo
  // passou a ligar os três; e o perfil gerado perdia skills/agents).
  // Gate de conta real: docs/PEDIDO-AUTORIZACAO-GATE-CONTA-REAL.md (anubis-gofu).
  "mcp": {
    // Fix 08/10/2026: o binário direto NÃO carregava o token (cofre hostinger.env), então o MCP
    // caía em OAuth/retry e PENDURAVA no `execute` (timeout infinito). Agora carrega o cofre antes.
    "hostinger-wordpress": {
      "type": "local",
      "command": [
        "/usr/bin/bash",
        "-c",
        "set -a; . /home/marcos/.config/anubis/hostinger.env; set +a; exec /home/marcos/.local/share/fnm/aliases/default/bin/node /home/marcos/.local/share/fnm/aliases/default/bin/hostinger-wordpress-mcp"
      ],
      "enabled": true,
      "environment": {
        "DEBUG": "false"
      }
    },
    // Fix 08/10/2026: mesmo defeito do hostinger-wordpress — o binário direto não carregava o
    // token (cofre hostinger.env) e travava em OAuth no `execute`. Carrega o cofre antes do exec.
    "hostinger-hosting": {
      "type": "local",
      "command": [
        "/usr/bin/bash",
        "-c",
        "set -a; . /home/marcos/.config/anubis/hostinger.env; set +a; exec /home/marcos/.local/share/fnm/aliases/default/bin/node /home/marcos/.local/share/fnm/aliases/default/bin/hostinger-hosting-mcp"
      ],
      "enabled": true,
      "environment": {
        "DEBUG": "false"
      }
    },
    // REABILITADO em 08/10/2026 por autorização expressa do dono (diagnóstico read-only de
    // campanhas). Estava desabilitado desde 29/09/2026 pelo lockout de produção. Credencial
    // reautenticada em 07/10 (adc.json + backups). Este MCP é read-only.
    "google-ads": {
      "type": "local",
      "command": [
        "/home/marcos/.config/google-ads-mcp/run.sh"
      ],
      "enabled": true
    },
    // REABILITADO em 08/10/2026 por autorização expressa do dono (diagnóstico read-only).
    "clickbank": {
      "type": "local",
      "command": [
        "/home/marcos/.config/clickbank-mcp/run.sh"
      ],
      "enabled": true
    },
    // Playwright MCP — DESABILITADO por padrão. Roteamento (AGENTS.md):
    // browser-harness (Go) é o padrão; habilite por sessão só a pedido do operador.
    // Versão pinada (nunca @latest). Para ativar: enabled: true e reinicie no início de sessão.
    "playwright": {
      "type": "local",
      "command": [
        "/home/marcos/.local/share/fnm/aliases/default/bin/node",
        "/home/marcos/.local/share/fnm/aliases/default/lib/node_modules/npm/bin/npx-cli.js",
        "-y",
        "@playwright/mcp@0.0.82"
      ],
      "enabled": false
    },
    // ai-memory — memória de longo prazo (MCP remoto). O token NÃO fica aqui: vem de
    // {file:...}, lido em runtime do cofre ~/.config/anubis/ai-memory.token (chmod 600,
    // não versionado). NÃO usar {env:}: o OpenCode Desktop sobe o servidor WSL SEM shell
    // (ambiente mínimo, sem AI_MEMORY_*), então só {file:} funciona nos dois caminhos.
    // Serviço: systemctl --user status ai-memory.service
    "ai-memory": {
      "type": "remote",
      "url": "http://memory.olivae.lan:49374/mcp",
      "headers": { "Authorization": "Bearer {file:/home/marcos/.config/anubis/ai-memory.token}" },
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*clickbank-mcp*": "ask"
    },
    "read": {
      "*clickbank-mcp*": "ask"
    },
    "edit": {
      "*clickbank-mcp*": "ask"
    }
  }
}
